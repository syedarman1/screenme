# Use a separate Supabase project and Stripe TEST mode for development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESUME_AI_MODEL=gpt-5.6-terra
NEXT_PUBLIC_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO=
STRIPE_PORTAL_CONFIGURATION=

# Set false until a verified production email sender is configured in Supabase.
NEXT_PUBLIC_EMAIL_DELIVERY_ENABLED=false

# Comma-separated verified auth user IDs allowed to view aggregate app health.
SCREENME_OPERATOR_IDS=
